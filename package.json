{
  "name": "PlaywrightQA",
  "version": "1.0.0",
  "description": "Playwright UI and API testing framework",
  "scripts": {
    "test": "playwright test src/tests/ui/ --project=chromium --grep \"@regression\"",
    "test:ui": "playwright test src/tests/ui/ --project=chromium --grep \"@regression\"",
    "test:ui:all": "playwright test src/tests/ui/ --project=chromium --project=Edge --grep \"@regression\"",
    "test:smoke": "playwright test src/tests/ui/ --project=chromium --grep \"@smoke\"",
    "test:regression": "playwright test src/tests/ui/ --project=chromium --grep \"@regression\"",
    "test:auth": "playwright test --project=chromium-auth --grep \"@auth\"",
    "test:a11y": "playwright test src/tests/ui/ --project=chromium --grep \"@a11y\"",
    "test:responsive": "playwright test src/tests/ui/ --project=chromium --grep \"@responsive\"",
    "test:visual": "playwright test src/tests/ui/ --project=chromium --grep \"@visual\"",
    "test:visual:update": "playwright test src/tests/ui/ --project=chromium --grep \"@visual\" --update-snapshots",
    "test:ci": "playwright test src/tests/ui/ --project=chromium --grep \"@regression\" --workers=2",
    "test:smoke:headed": "playwright test src/tests/ui/ --project=chromium --grep \"@smoke\" --headed",
    "test:debug": "playwright test src/tests/ui/ --project=chromium --grep \"@smoke\" --debug",
    "typecheck": "tsc --noEmit",
    "report": "npx playwright show-report"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.6.1",
    "env": "^0.0.2",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@types/axios": "^0.9.36",
    "@types/dotenv": "^6.1.1",
    "@types/exceljs": "^0.5.3",
    "@types/node": "^22.19.18",
    "typescript": "^5.8.3",
    "checkly": "latest"
  }
}