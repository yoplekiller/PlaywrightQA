{
  "name": "PlaywrightQA",
  "version": "1.0.0",
  "description": "Playwright UI and API testing framework",
  "scripts": {
    "test": "playwright test src/tests/ui/ --project=chromium",
    "test:ui": "playwright test src/tests/ui/ --project=chromium",
    "test:ui:all": "playwright test src/tests/ui/ --project=chromium --project=Edge",
    "test:auth": "playwright test --project=chromium-auth",
    "test:smoke": "playwright test src/tests/ui/ui_search.spec.ts --project=chromium",
    "test:visual": "playwright test src/tests/ui/ui_visual_regression.spec.ts --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "npx playwright show-report"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.6.1",
    "env": "^0.0.2",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@types/axios": "^0.9.36",
    "@types/dotenv": "^6.1.1",
    "@types/exceljs": "^0.5.3",
    "@types/node": "^22.19.18",
    "typescript": "^5.8.3"
  }
}
